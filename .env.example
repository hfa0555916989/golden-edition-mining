# Password for the /admin dashboard
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
ADMIN_SECRET=long-random-string
# Vercel Blob token (set automatically when a Blob store is connected to the Vercel project)
BLOB_READ_WRITE_TOKEN=
# Optional: public site URL used in sitemap/OG (defaults to the Vercel URL)
NEXT_PUBLIC_SITE_URL=
